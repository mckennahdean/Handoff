# Coverage settings, used by pytest-cov locally and in CI.
[run]
source = backend
omit =
    # Test files are the measuring stick, not the thing measured.
    backend/test_*.py
    # Old manual scripts that are not part of the test suite.
    backend/test.py
    backend/test_embedding.py

[report]
show_missing = True
skip_empty = True
# Thin command-line launchers. Their logic lives in functions
# that the tests call directly, so only the entry point is skipped.
exclude_also =
    if __name__ == .__main__.:
