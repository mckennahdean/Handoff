# Copy this file to .env and fill in your values.
# The .env file is gitignored and should never be committed.

# Google Gemini API key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# PostgreSQL connection string.
# The default below works with the docker-compose.yml at the repo root.
DATABASE_URL=postgresql+psycopg://handoff_user:handoff_password@localhost:5432/handoff

# Secret used to sign login tokens. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=2a645a997c5db66954e9452e945b84afcf744bbe4c9172352b84bf5f8f042dbb


# Minimum cosine similarity for Handoff to answer from a procedure.
# Below this, Handoff abstains and logs a knowledge gap.
ANSWER_THRESHOLD=0.70

# Minimum similarity for two unanswered questions to count as the
# same knowledge gap. Stricter than the answer threshold, because
# two questions must mean nearly the same thing to be grouped.
GAP_GROUPING_THRESHOLD=0.75

# Gemini models. Check your key's limits at https://ai.dev/rate-limit
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_STRUCTURE_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001