# Copy this file to .env and fill in your values.
# The .env file is gitignored and should never be committed.

# Google Gemini API key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# PostgreSQL connection string.
# The default below works with the docker-compose.yml at the repo root.
DATABASE_URL=postgresql+psycopg://handoff_user:handoff_password@localhost:5432/handoff

# Secret used to sign login tokens. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=2a645a997c5db66954e9452e945b84afcf744bbe4c9172352b84bf5f8f042dbb